<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar { height: 100vh; background-color: #343a40; color: white; padding-top: 20px; }
        .sidebar a { color: #adb5bd; text-decoration: none; display: block; padding: 10px 20px; }
        .sidebar a:hover, .sidebar a.active { background-color: #495057; color: white; }
        .room-card-actions {
            position: absolute;
            top: 12px;
            right: 12px;
            display: flex;
            gap: 8px;
            z-index: 2;
        }
        .room-card-action {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            border-radius: 50%;
        }
        .room-card-action svg {
            width: 18px;
            height: 18px;
        }
        .room-card-title {
            padding-right: 48px;
        }
    </style>
</head>
<body>

<div class="offcanvas offcanvas-start bg-dark text-white shadow" data-bs-scroll="true" data-bs-backdrop="false" tabindex="-1" id="adminSidebar" style="width: 250px;">
  <div class="offcanvas-header border-bottom border-secondary py-4 d-flex align-items-center justify-content-between">
    <h5 class="offcanvas-title m-0"><a href="/" class="text-white text-decoration-none">VoteX Organizer</a></h5>
    <button type="button" class="btn-close btn-close-white m-0" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body p-0 sidebar pt-3" style="min-height: auto; height: auto;">
      <a href="/admin/dashboard" class="active">My Election Rooms</a>
      <a href="/admin/voters">Global Voters</a>
      <a href="/admin/logout" class="text-danger mt-5">Logout</a>
  </div>
</div>

<div class="container-fluid" id="mainWrapper" style="transition: padding-left 0.3s ease;">
    <div class="row">
        <!-- Main Content -->
        <div class="col-12 p-4">
            <button class="btn text-dark p-0 mb-4 d-inline-flex align-items-center" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-label="Open Sidebar Menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
            </button>
            <h2>Welcome, <%= admin.username %></h2>
            <hr>
            
            <% if(success_msg && success_msg.length > 0){ %>
                <div class="alert alert-success"><%= success_msg %></div>
            <% } %>
            <% if(error_msg && error_msg.length > 0){ %>
                <div class="alert alert-danger"><%= error_msg %></div>
            <% } %>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4>Your Election Rooms</h4>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRoomModal">+ Create New Election Room</button>
            </div>

            <div class="row">
                <% if(rooms.length === 0) { %>
                    <div class="col-12"><p class="text-muted">You have not created any election rooms yet.</p></div>
                <% } else { %>
                    <% rooms.forEach(room => { %>
                        <div class="col-md-4 mb-4">
                            <div class="card shadow-sm border-top border-primary border-4 position-relative">
                                <div class="room-card-actions">
                                    <% if(room.status === 'active') { %>
                                        <form action="/admin/rooms/<%= room.id %>/terminate" method="POST" class="m-0">
                                            <button type="submit" class="btn btn-warning room-card-action" title="Terminate election" aria-label="Terminate election" onclick="return confirm('Terminate this active election? Voters will no longer be able to vote.')">
                                                <i data-lucide="ban"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                    <% if(room.status === 'published' || room.status === 'closed') { %>
                                        <form action="/admin/rooms/<%= room.id %>/delete" method="POST" class="m-0">
                                            <button type="submit" class="btn btn-danger room-card-action" title="Delete room" aria-label="Delete room" onclick="return confirm('Delete this completed election room permanently?')">
                                                <i data-lucide="trash-2"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title fw-bold room-card-title"><%= room.title %></h5>
                                    <p class="text-muted small"><%= room.description %></p>
                                    <hr>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-<%= room.status === 'active' ? 'success' : (room.status === 'published' ? 'info' : 'secondary') %>">
                                            <%= room.status.toUpperCase() %>
                                        </span>
                                        <strong>Code: <%= room.room_code %></strong>
                                    </div>
                                    <a href="/admin/rooms/<%= room.id %>" class="btn btn-outline-dark w-100 mt-3">Manage Room</a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

        </div>
    </div>
</div>

<!-- Create Room Modal -->
<div class="modal fade" id="createRoomModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Create Election Room</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/rooms" method="POST">
          <div class="modal-body">
              <div class="mb-3">
                  <label class="form-label">Election Title</label>
                  <input type="text" name="title" class="form-control" required placeholder="e.g., Class Representative Election">
              </div>
              <div class="mb-3">
                  <label class="form-label">Description</label>
                  <textarea name="description" class="form-control" rows="3" placeholder="Rules or info about this election..."></textarea>
              </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary">Create Room</button>
          </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script>
    lucide.createIcons();

    const adminSidebar = document.getElementById('adminSidebar');
    const mainWrapper = document.getElementById('mainWrapper');
    if (adminSidebar && mainWrapper) {
        adminSidebar.addEventListener('show.bs.offcanvas', () => {
            if (window.innerWidth >= 768) {
                mainWrapper.style.paddingLeft = '250px';
            }
        });
        adminSidebar.addEventListener('hide.bs.offcanvas', () => {
            mainWrapper.style.paddingLeft = '0';
        });
    }
</script>
</body>
</html>
