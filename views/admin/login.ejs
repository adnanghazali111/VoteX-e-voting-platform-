<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f4f7f6; display: flex; align-items: center; justify-content: center; min-height: 100vh; font-family: 'Inter', sans-serif;}
        .card { border-radius: 15px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1); width: 100%; max-width: 400px; padding: 30px;}
    </style>
</head>
<body>
    <%- include('../partials/home-logo') %>
    <div class="card">
        <h3 class="text-center fw-bold mb-4">Organizer Login</h3>
        <% if (locals.error_msg && locals.error_msg.length > 0) { %>
            <div class="alert alert-danger"><%= error_msg %></div>
        <% } %>
        <% if (locals.success_msg && locals.success_msg.length > 0) { %>
            <div class="alert alert-success"><%= success_msg %></div>
        <% } %>
        <a href="/admin/auth/google" class="btn btn-outline-dark w-100 mb-3">
            Continue with Google <span class="text-muted">(optional)</span>
        </a>
        <form action="/admin/login" method="POST">
            <div class="mb-3">
                <label for="organizer_name" class="form-label text-muted">Organizer Name</label>
                <input type="text" id="organizer_name" name="organizer_name" class="form-control form-control-lg" required aria-required="true" placeholder="Enter your name" autocomplete="name">
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill">Login</button>
        </form>
        <div class="text-center mt-4">
            <a href="/" class="text-decoration-none text-muted">Back to Home</a>
        </div>
    </div>
</body>
</html>
