<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar { height: 100vh; background-color: #343a40; color: white; padding-top: 20px; }
        .sidebar a { color: #adb5bd; text-decoration: none; display: block; padding: 10px 20px; }
        .sidebar a:hover, .sidebar a.active { background-color: #495057; color: white; }
    </style>
</head>
<body>
<div class="offcanvas offcanvas-start bg-dark text-white shadow" data-bs-scroll="true" data-bs-backdrop="false" tabindex="-1" id="adminSidebar" style="width: 250px;">
  <div class="offcanvas-header border-bottom border-secondary pt-4 pb-3">
    <h4 class="offcanvas-title w-100 text-center"><a href="/" class="text-white text-decoration-none">VoteX Organizer</a></h4>
    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body p-0 sidebar pt-3" style="min-height: auto; height: auto;">
      <a href="/admin/dashboard">My Election Rooms</a>
      <a href="/admin/voters">Global Voters</a>
      <a href="/admin/logout" class="text-danger mt-5">Logout</a>
  </div>
</div>

<div class="container-fluid" id="mainWrapper" style="transition: padding-left 0.3s ease;">
    <div class="row">
        <div class="col-12 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <button class="btn text-dark p-0 d-inline-flex align-items-center" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
                </button>
                <a href="/admin/rooms/<%= room.id %>" class="btn btn-outline-secondary fw-bold shadow-sm">&larr; Back to Room</a>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">Participating Voters</h2>
                    <p class="text-muted mb-0"><%= room.title %> &bull; Room PIN: <strong><%= room.room_code %></strong></p>
                </div>
                <span class="badge bg-primary rounded-pill fs-6"><%= participatingVoters.length %></span>
            </div>

            <%- include('../partials/messages') %>

            <div class="table-responsive">
                <table class="table table-bordered bg-white align-middle">
                    <thead>
                        <tr>
                            <th>College ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Votes Cast</th>
                            <th>Last Voted</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% participatingVoters.forEach(voter => { %>
                            <tr>
                                <td><%= voter.voter_id %></td>
                                <td><%= voter.name %></td>
                                <td><%= voter.email %></td>
                                <td><%= voter.votes_cast %></td>
                                <td><%= voter.last_voted_at ? new Date(voter.last_voted_at).toLocaleString() : '-' %></td>
                            </tr>
                        <% }) %>
                        <% if(participatingVoters.length === 0) { %>
                            <tr><td colspan="5" class="text-center text-muted py-4">No voters have participated in this room yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const adminSidebar = document.getElementById('adminSidebar');
    const mainWrapper = document.getElementById('mainWrapper');
    if (adminSidebar && mainWrapper) {
        adminSidebar.addEventListener('show.bs.offcanvas', () => {
            if (window.innerWidth >= 768) {
                mainWrapper.style.paddingLeft = '250px';
            }
        });
        adminSidebar.addEventListener('hide.bs.offcanvas', () => {
            mainWrapper.style.paddingLeft = '0';
        });
    }
</script>
</body>
</html>
