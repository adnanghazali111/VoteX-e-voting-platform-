<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { 
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); 
            color: white; 
            font-family: 'Inter', sans-serif; 
            min-height: 100vh;
        }
        .results-header {
            text-align: center;
            padding: 50px 0;
            animation: fadeInDown 1s ease;
        }
        .position-section {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 40px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            animation: fadeInUp 1s ease;
        }
        .winner-card {
            background: linear-gradient(45deg, #FFD700, #FFA500);
            color: black;
            border-radius: 15px;
            padding: 20px;
            transform: scale(1.05);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            border: 3px solid white;
            text-align: center;
            position: relative;
        }
        .winner-badge {
            position: absolute;
            top: -15px;
            right: -15px;
            background: #dc3545;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9rem;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            animation: pulse 1.5s infinite;
        }
        .runner-up-card {
            background: rgba(255, 255, 255, 0.9);
            color: #333;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
        }
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <%- include('../partials/home-logo') %>

    <div class="container">
        <div class="results-header">
            <h1 class="display-3 fw-bold text-warning">OFFICIAL RESULTS</h1>
            <h3 class="fw-light"><%= room.title %></h3>
            <p class="lead opacity-75">Thank you to all who participated in this election.</p>
        </div>

        <% Object.keys(positionsData).forEach(positionTitle => { %>
            <div class="position-section shadow-lg">
                <h2 class="text-center mb-4 border-bottom pb-2 border-light"><%= positionTitle %></h2>
                
                <div class="row justify-content-center align-items-end g-4">
                    <% 
                    const candidates = positionsData[positionTitle];
                    if (candidates.length > 0) { 
                        const winner = candidates[0];
                    %>
                        <!-- WINNER -->
                        <div class="col-md-6 col-lg-5 col-xl-4 mx-auto z-3">
                            <div class="winner-card">
                                <div class="winner-badge">WINNER! 🏆</div>
                                <img src="<%= winner.photo_url %>" alt="<%= winner.candidate_name %>" class="rounded-circle mb-3" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid white;">
                                <h3 class="fw-bold"><%= winner.candidate_name %></h3>
                                <div class="d-flex justify-content-center align-items-center mb-2">
                                    <% if(winner.party_symbol_url) { %>
                                        <img src="<%= winner.party_symbol_url %>" width="25" height="25" class="me-2">
                                    <% } %>
                                    <h6 class="m-0"><%= winner.party || 'Independent' %></h6>
                                </div>
                                <h4 class="fw-bold mt-3 text-dark"><%= winner.vote_count %> Votes</h4>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="col-12 text-center">
                            <p class="text-light opacity-50">No candidates for this position.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }) %>
        
        <div class="text-center mt-5 mb-5 pb-5">
            <a href="/" class="btn btn-outline-light btn-lg px-5 rounded-pill">Return to Home</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script>
        // Trigger confetti on load
        window.onload = function() {
            var duration = 3000;
            var animationEnd = Date.now() + duration;
            var defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };

            function randomInRange(min, max) {
                return Math.random() * (max - min) + min;
            }

            var interval = setInterval(function() {
                var timeLeft = animationEnd - Date.now();

                if (timeLeft <= 0) {
                    return clearInterval(interval);
                }

                var particleCount = 50 * (timeLeft / duration);
                confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
                confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
            }, 250);
        };
    </script>
</body>
</html>
