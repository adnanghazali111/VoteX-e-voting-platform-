<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f8ff; font-family: 'Inter', sans-serif; }
        .navbar-custom { background-color: #0d6efd; }
        .position-card { border-top: 4px solid #0d6efd; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .nominee-photo { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 2px solid #dee2e6; }
        .party-symbol { width: 26px; height: 26px; object-fit: cover; border-radius: 50%; border: 1px solid #dee2e6; }
        .nominee-row { min-height: 76px; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">VoteX Portal</a>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white fw-bold" href="/voter/profile">Welcome, <%= user.name %></a>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link text-white fw-bold">|</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/voter/logout">Logout & Leave Room</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5 mb-5">
        <h2 class="fw-bold"><%= room.title %> - Election Ballot</h2>
        <p class="text-muted">Review each position and vote for one nominee.</p>
        
        <% if(room.status === 'published') { %>
            <div class="alert alert-info border-info d-flex justify-content-between align-items-center shadow-sm">
                <div>
                    <strong><i data-lucide="info" class="me-2" style="width: 18px; height: 18px;"></i> Results Published!</strong>
                    The official results for this election are now available to view.
                </div>
                <a href="/results/<%= room.code %>" class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm" target="_blank">View Results</a>
            </div>
        <% } %>

        <hr>

        <% if(success_msg && success_msg.length > 0){ %>
            <div class="alert alert-success"><%= success_msg %></div>
        <% } %>
        <% if(error_msg && error_msg.length > 0){ %>
            <div class="alert alert-danger"><%= error_msg %></div>
        <% } %>

        <% if(positions.length === 0) { %>
            <div class="alert alert-info">No active positions available for voting at this time.</div>
        <% } else { %>
            <% positions.forEach(function(position) { %>
                <div class="card position-card mb-4">
                    <div class="card-header bg-white pb-0 border-0 pt-3">
                        <h4 class="fw-bold text-primary"><%= position.title %></h4>
                    </div>
                    <div class="card-body p-0">
                        <% const votedCandidateId = votedCandidateByPosition[position.id]; %>
                        <div class="list-group list-group-flush">
                            <%
                            let hasCandidates = false;
                            candidates.forEach(function(candidate) {
                                if(candidate.position_id === position.id) {
                                    hasCandidates = true;
                                    const isLockedChoice = votedCandidateId === candidate.id;
                            %>
                                <div class="list-group-item nominee-row d-flex align-items-center gap-3">
                                    <img src="<%= candidate.photo_url %>" alt="<%= candidate.name %>" class="nominee-photo flex-shrink-0">
                                    <div class="flex-grow-1">
                                        <div class="fw-bold"><%= candidate.name %></div>
                                        <div class="d-flex align-items-center gap-2 text-muted small">
                                            <% if(candidate.party_symbol_url) { %>
                                                <img src="<%= candidate.party_symbol_url %>" alt="" class="party-symbol">
                                            <% } %>
                                            <span><%= candidate.party || 'Independent' %></span>
                                        </div>
                                        <% if(candidate.manifesto) { %>
                                            <div class="small text-muted mt-1"><%= candidate.manifesto %></div>
                                        <% } %>
                                    </div>
                                    <% if(votedCandidateId) { %>
                                        <button type="button" class="btn <%= isLockedChoice ? 'btn-success' : 'btn-outline-secondary' %> fw-bold px-4" disabled>
                                            <%= isLockedChoice ? 'Locked' : 'Closed' %>
                                        </button>
                                    <% } else { %>
                                        <form action="/voter/vote" method="POST" class="m-0 vote-form">
                                            <input type="hidden" name="position_id" value="<%= position.id %>">
                                            <input type="hidden" name="candidate_id" value="<%= candidate.id %>">
                                            <button type="button" class="btn btn-primary fw-bold px-4 init-vote-btn">Vote</button>
                                            <button type="submit" class="btn btn-success fw-bold px-4 confirm-vote-btn d-none">Lock</button>
                                        </form>
                                    <% } %>
                                </div>
                            <%
                                }
                            });
                            %>
                            <% if(!hasCandidates) { %>
                                <div class="list-group-item text-muted text-center py-3">No nominees for this position.</div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>

    <!-- Report FAB -->
    <button class="btn btn-danger rounded-circle shadow-lg position-fixed bottom-0 end-0 m-4 d-flex justify-content-center align-items-center" style="width: 60px; height: 60px; z-index: 1000;" data-bs-toggle="modal" data-bs-target="#reportModal" title="Report an Issue">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
    </button>

    <!-- Report Modal -->
    <div class="modal fade" id="reportModal" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title fw-bold">Report an Issue</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <form action="/voter/report" method="POST">
              <input type="hidden" name="room_id" value="<%= room.id %>">
              <div class="modal-body">
                  <div class="mb-3">
                      <label class="form-label fw-bold">What is the issue?</label>
                      <select name="issue_type" class="form-select" required>
                          <option value="">-- Select an issue --</option>
                          <option value="Compromised Vote">My vote was already cast by someone else</option>
                          <option value="Wrong Vote">I voted for the wrong person</option>
                          <option value="Other">Other</option>
                      </select>
                  </div>
                  <div class="mb-3">
                      <label class="form-label fw-bold">Additional Details (Optional)</label>
                      <textarea name="message" class="form-control" rows="3" placeholder="Please provide any details to help the admin investigate..."></textarea>
                  </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger fw-bold">Submit Report</button>
              </div>
          </form>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.init-vote-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const positionCard = this.closest('.position-card');
                
                positionCard.querySelectorAll('.init-vote-btn').forEach(b => {
                    b.classList.remove('d-none');
                    b.classList.replace('btn-secondary', 'btn-primary');
                });
                positionCard.querySelectorAll('.confirm-vote-btn').forEach(b => b.classList.add('d-none'));
                
                positionCard.querySelectorAll('.init-vote-btn').forEach(b => {
                    if (b !== this) {
                        b.classList.replace('btn-primary', 'btn-secondary');
                    }
                });

                this.classList.add('d-none');
                this.nextElementSibling.classList.remove('d-none');
            });
        });
    </script>
</body>
</html>
