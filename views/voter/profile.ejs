<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f8ff; font-family: 'Inter', sans-serif; }
        .navbar-custom { background-color: #0d6efd; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">VoteX Portal</a>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/voter/dashboard">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link text-white fw-bold">|</span>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link text-white fw-bold">Welcome, <%= user.name %></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/voter/logout">Logout & Leave Room</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h2 class="fw-bold">My Profile</h2>
                <hr>

                <% if(success_msg && success_msg.length > 0){ %>
                    <div class="alert alert-success"><%= success_msg %></div>
                <% } %>
                <% if(error_msg && error_msg.length > 0){ %>
                    <div class="alert alert-danger"><%= error_msg %></div>
                <% } %>

                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Account Details</h5>
                        <p class="mb-1"><strong>Name:</strong> <%= user.name %></p>
                        <p class="mb-1"><strong>College ID:</strong> <%= user.voter_id %></p>
                        <p class="mb-1"><strong>Email:</strong> <%= user.email %></p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
